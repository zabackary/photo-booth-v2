  "version": "0.2.0",

  "configurations": [
    {
      "name": "Debug executable",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=photo-booth-v2",
          "--",
          "--config",
          "config.example.json",
        ],
        "env": {
          "RUST_LOG": "photo_booth_v2=debug",
          "_NO_DEBUG_HEAP": "1",
        },
      },
      "lldb.evaluateForLanguage": true,
      "lldb.verbose": false,
      "args": [],
    },
